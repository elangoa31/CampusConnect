# CampusConnect Supabase Authentication Configuration
# Replace these with your actual Supabase Project URL and Anon/Publishable Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys (anon, public)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Set this to your deployed Vercel domain in production (e.g., https://your-project.vercel.app)
# If not set, CampusConnect dynamically resolves window.location.origin (e.g., http://localhost:5173 locally)
VITE_SITE_URL=https://your-project.vercel.app

